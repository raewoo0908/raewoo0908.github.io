---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Bilingual from '../components/Bilingual.astro';
import DocToc from '../components/DocToc.astro';
import { getPageEntries } from '../lib/content';
import { buildTocTree } from '../lib/toc';

const cv = await getPageEntries('cv');
const title = cv.ko?.data.title ?? cv.en?.data.title ?? 'CV';

// 목차용 heading 목록(언어별). Bilingual이 본문을 렌더하고, 여기선 목차만 뽑는다.
const koHeadings = cv.ko ? (await render(cv.ko)).headings : [];
const enHeadings = cv.en ? (await render(cv.en)).headings : [];
const koToc = buildTocTree(koHeadings);
const enToc = buildTocTree(enHeadings);
---

<BaseLayout title={title}>
  <div class="doc-layout cv-layout">
    <article class="doc-layout__body">
      <Bilingual ko={cv.ko} en={cv.en} />
    </article>
    <aside class="doc-layout__aside">
      <DocToc ko={koToc} en={enToc} />
    </aside>
  </div>
</BaseLayout>

<style>
  /* 긴 날짜 줄(` %% 날짜`)이 한 줄에 들어오도록 CV만 본문을 넓게 쓴다. */
  .cv-layout {
    --doc-layout-width: 72rem;
  }
</style>
