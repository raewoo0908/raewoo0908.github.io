---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bilingual from '../../components/Bilingual.astro';
import DocList from '../../components/DocList.astro';
import BiText from '../../components/BiText.astro';
import DocToc from '../../components/DocToc.astro';
import PostToc from '../../components/PostToc.astro';
import { getBilingualDocs, type BilingualDoc, type BilingualCollection } from '../../lib/content';
import { getCategoryPaths, docsInCategory } from '../../lib/categories';
import { buildTocTree, withRawHeadings, type TocNode } from '../../lib/toc';
import { humanize } from '../../lib/i18n';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const collections: BilingualCollection[] = ['posts', 'projects', 'experiences'];
  const paths = [];
  for (const collection of collections) {
    const docs = await getBilingualDocs(collection);
    for (const doc of docs) {
      paths.push({
        params: { collection, path: doc.path },
        props: { kind: 'doc' as const, collection, path: doc.path },
      });
    }
    for (const catPath of getCategoryPaths(docs)) {
      paths.push({
        params: { collection, path: catPath },
        props: { kind: 'category' as const, collection, path: catPath },
      });
    }
  }
  return paths;
}

const { kind, collection, path } = Astro.props;
const docs = await getBilingualDocs(collection);

const fmtDate = (d?: Date) => (d ? d.toISOString().slice(0, 10) : '');

let doc: BilingualDoc | undefined;
let categoryDocs: BilingualDoc[] = [];
let title = path;
let koToc: TocNode[] = [];
let enToc: TocNode[] = [];

if (kind === 'doc') {
  doc = docs.find((d) => d.path === path);
  title = doc?.title.ko ?? doc?.title.en ?? path;

  // 목차용 heading 목록(언어별). Bilingual이 본문을 렌더하고, 여기선 목차만 뽑는다.
  // remarkPluginFrontmatter로 커스텀 이모지가 살아있는 원문도 함께 받는다.
  const koRendered = doc?.entries.ko ? await render(doc.entries.ko) : undefined;
  const enRendered = doc?.entries.en ? await render(doc.entries.en) : undefined;
  const koHeadings = withRawHeadings(
    koRendered?.headings ?? [],
    koRendered?.remarkPluginFrontmatter?.__emojiHeadings,
    `${path} (ko)`,
  );
  const enHeadings = withRawHeadings(
    enRendered?.headings ?? [],
    enRendered?.remarkPluginFrontmatter?.__emojiHeadings,
    `${path} (en)`,
  );
  // 번역이 없으면 본문이 반대 언어로 폴백되므로(Bilingual) 목차도 같이 폴백한다.
  koToc = buildTocTree(koHeadings.length > 0 ? koHeadings : enHeadings);
  enToc = buildTocTree(enHeadings.length > 0 ? enHeadings : koHeadings);
} else {
  categoryDocs = docsInCategory(docs, path);
  title = humanize(path.split('/').pop() ?? path);
}
---

<BaseLayout title={title}>
  {
    kind === 'doc' && doc ? (
      <div class="doc-layout">
        <article class="doc-layout__body">
          <header class="doc-header">
            <div class="doc-header__meta">
              {doc.date && <time>{fmtDate(doc.date)}</time>}
              {doc.categorySegments.length > 0 && (
                <a href={withBase(`/${collection}/${doc.categoryPath}`)} class="doc-header__cat">
                  {doc.categorySegments.map(humanize).join(' / ')}
                </a>
              )}
            </div>
            <h1>
              <BiText ko={doc.title.ko} en={doc.title.en} />
            </h1>
          </header>
          <PostToc ko={koToc} en={enToc} />
          <Bilingual ko={doc.entries.ko} en={doc.entries.en} />
        </article>
        <aside class="doc-layout__aside">
          <DocToc ko={koToc} en={enToc} />
        </aside>
      </div>
    ) : (
      <div class="container">
        <header class="page-header">
          <p class="eyebrow">{collection}</p>
          <h1>{title}</h1>
        </header>
        <DocList docs={categoryDocs} collection={collection} />
      </div>
    )
  }
</BaseLayout>

<style>
  .doc-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .doc-header__meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .doc-header h1 {
    font-size: var(--text-3xl);
    margin: 0;
    line-height: 1.25;
  }
</style>
