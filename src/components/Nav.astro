---
import { getBilingualDocs } from '../lib/content';
import { buildCategoryTree } from '../lib/categories';
import { UI } from '../lib/i18n';
import { withBase } from '../lib/url';
import NavTree from './NavTree.astro';
import LangToggle from './LangToggle.astro';

const [posts, projects, experiences] = await Promise.all([
  getBilingualDocs('posts'),
  getBilingualDocs('projects'),
  getBilingualDocs('experiences'),
]);

const menus = [
  { key: 'projects', label: UI.projects, tree: buildCategoryTree(projects) },
  { key: 'experiences', label: UI.experiences, tree: buildCategoryTree(experiences) },
  { key: 'posts', label: UI.posts, tree: buildCategoryTree(posts) },
] as const;

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== withBase('/') && path.startsWith(href));
---

<header class="site-header">
  <div class="container container-wide header-inner">
    <a class="brand" href={withBase('/')}>raewoo0908</a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav-list">
        <li>
          <a href={withBase('/')} class:list={['nav-link', { active: path === withBase('/') }]}>
            <span data-lang-block="ko">{UI.home.ko}</span><span data-lang-block="en">{UI.home.en}</span>
          </a>
        </li>
        <li>
          <a href={withBase('/cv')} class:list={['nav-link', { active: isActive(withBase('/cv')) }]}>
            <span data-lang-block="ko">{UI.cv.ko}</span><span data-lang-block="en">{UI.cv.en}</span>
          </a>
        </li>
        {
          menus.map((m) => (
            <li class="has-dropdown">
              <a
                href={withBase(`/${m.key}`)}
                class:list={['nav-link', { active: isActive(withBase(`/${m.key}`)) }]}
              >
                <span data-lang-block="ko">{m.label.ko}</span>
                <span data-lang-block="en">{m.label.en}</span>
                {m.tree.length > 0 && (
                  <span class="caret" aria-hidden="true">
                    ▾
                  </span>
                )}
              </a>
              {m.tree.length > 0 && (
                <div class="dropdown">
                  <div class="dropdown__inner">
                    <NavTree nodes={m.tree} collection={m.key} />
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <LangToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--color-border);
    transition: background-color 0.2s ease, border-color 0.2s ease;
    /* 드롭다운 배경 띠가 좌우로 화면 끝까지 번지되(아래 .dropdown::before),
       가로 스크롤은 생기지 않게 잘라낸다. clip은 hidden과 달리 세로축을
       visible로 남겨두므로 드롭다운이 헤더 아래로 삐져나올 수 있다. */
    overflow-x: clip;
    overflow-y: visible;
  }
  /* 드롭다운이 열리면 헤더 아래 경계선은 늘어난 띠의 맨 아래로 옮겨간다
     (경계선이 확장된 바 한가운데를 가로지르지 않도록). */
  .site-header:has(.has-dropdown:hover, .has-dropdown:focus-within) {
    background: var(--color-bg);
    border-bottom-color: transparent;
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-height);
  }
  .brand {
    font-weight: 800;
    font-size: var(--text-lg);
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
  .brand:hover {
    text-decoration: none;
    color: var(--color-accent);
  }
  .nav {
    flex: 1;
    display: flex;
    justify-content: center;
    min-width: 0;
    /* 각 메뉴 항목이 바 높이를 꽉 채워야 링크와 드롭다운 사이에 틈이 안 생긴다. */
    align-self: stretch;
  }
  .nav-list {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list > li {
    display: flex;
    align-items: center;
  }
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.45rem 0.7rem;
    border-radius: 7px;
    color: var(--color-text);
    font-weight: 600;
    white-space: nowrap;
  }
  .nav-link:hover {
    background: var(--color-surface);
    color: var(--color-accent);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--color-accent);
  }
  .caret {
    display: inline-block;
    font-size: 0.7em;
    color: var(--color-text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .has-dropdown:hover > .nav-link .caret,
  .has-dropdown:focus-within > .nav-link .caret {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .has-dropdown {
    position: relative;
  }
  /* 드롭다운은 카드가 아니라 '늘어난 메뉴바의 아랫부분'이다.
     ::before가 좌우 화면 끝까지 뻗는 바 배경을 그리고, clip-path가
     위에서 아래로 커튼처럼 열리며 바가 길어지는 것처럼 보이게 한다. */
  .dropdown {
    position: absolute;
    top: 100%;
    left: 0.2rem;
    min-width: 13rem;
    padding: 0.4rem 0 0.9rem;
    visibility: hidden;
    clip-path: inset(0 -100vw 100% -100vw);
    transition: clip-path 0.22s ease, visibility 0.22s;
  }
  .dropdown::before {
    content: '';
    position: absolute;
    inset: 0 -100vw;
    z-index: -1;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 10px 24px rgba(16, 24, 40, 0.06);
  }
  .dropdown__inner {
    max-height: 70vh;
    overflow-y: auto;
  }
  .has-dropdown:hover > .dropdown,
  .has-dropdown:focus-within > .dropdown {
    visibility: visible;
    clip-path: inset(0 -100vw 0 -100vw);
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown,
    .caret,
    .site-header {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .nav {
      order: 3;
      /* flex-basis 100%라야 브랜드/토글과 같은 줄에 끼지 않고 자기 줄로 내려간다
         (flex: 1의 basis 0이 width: 100%를 덮어썼었다). */
      flex: 1 1 100%;
      justify-content: flex-start;
    }
    .nav-list {
      justify-content: flex-start;
    }
    /* 좁은 화면에서는 드롭다운을 헤더 폭 전체로 (오른쪽 잘림 방지) */
    .has-dropdown {
      position: static;
    }
    .dropdown {
      left: 0;
      right: 0;
      min-width: 0;
      padding: 0.4rem 1.25rem 0.9rem;
    }
  }
</style>
